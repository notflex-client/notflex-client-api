PORT=3000
CLIENT_APP_URL=http://localhost:8386
DB_DSN=host=localhost user=postgres password=YOUR_DB_PASSWORD dbname=notflex_project port=5432 sslmode=disable TimeZone=Asia/Ho_Chi_Minh

# SMTP — for verification + login code + reset password emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Notflex <noreply@notflex.com>

# Stripe — get keys at https://dashboard.stripe.com/test/apikeys
# Webhook secret comes from running: stripe listen --forward-to localhost:3000/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME