package templates

type LoginCodeParam struct {
	Code  string
	Email string
}

templ LoginCode(locale string, param LoginCodeParam) {
	if locale == "vi" {
		@LoginCodeVi(param)
	} else {
		@LoginCodeEn(param)
	}
}

templ LoginCodeEn(param LoginCodeParam) {
	@EmailLayout("Sign in to Notflex") {
		<h2 style="margin:0 0 16px 0;font-size:18px;font-weight:700;color:#ffffff;">
			Sign in with code
		</h2>
		<p style="margin:0 0 24px 0;font-size:14px;line-height:1.6;color:#b3b3b3;">
			Use the code below to sign in to your Notflex account. The code expires in <strong style="color:#ffffff;">5 minutes</strong>.
		</p>

		<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
			<tr>
				<td align="center">
					<div style="display:inline-block;background-color:#2a2a2a;border:1px solid #333333;border-radius:8px;padding:20px 48px;text-align:center;">
						<p style="margin:0 0 6px 0;font-size:11px;font-weight:600;color:#808080;letter-spacing:2px;text-transform:uppercase;">Sign-in Code</p>
						<p style="margin:0;font-size:40px;font-weight:900;color:#e50914;letter-spacing:10px;">{ param.Code }</p>
					</div>
				</td>
			</tr>
		</table>

		<p style="margin:0;font-size:13px;line-height:1.6;color:#808080;">
			If you did not request this, you can safely ignore this email.
		</p>
	}
}

templ LoginCodeVi(param LoginCodeParam) {
	@EmailLayout("Đăng nhập Notflex") {
		<h2 style="margin:0 0 16px 0;font-size:18px;font-weight:700;color:#ffffff;">
			Đăng nhập bằng mã
		</h2>
		<p style="margin:0 0 24px 0;font-size:14px;line-height:1.6;color:#b3b3b3;">
			Dùng mã bên dưới để đăng nhập vào tài khoản Notflex của bạn. Mã có hiệu lực trong <strong style="color:#ffffff;">5 phút</strong>.
		</p>

		<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
			<tr>
				<td align="center">
					<div style="display:inline-block;background-color:#2a2a2a;border:1px solid #333333;border-radius:8px;padding:20px 48px;text-align:center;">
						<p style="margin:0 0 6px 0;font-size:11px;font-weight:600;color:#808080;letter-spacing:2px;text-transform:uppercase;">Mã đăng nhập</p>
						<p style="margin:0;font-size:40px;font-weight:900;color:#e50914;letter-spacing:10px;">{ param.Code }</p>
					</div>
				</td>
			</tr>
		</table>

		<p style="margin:0;font-size:13px;line-height:1.6;color:#808080;">
			Nếu bạn không yêu cầu đăng nhập, vui lòng bỏ qua email này.
		</p>
	}
}
